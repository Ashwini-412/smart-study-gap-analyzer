# Copy to .env (git-ignored), fill in the password, then load it into your shell:
#   set -a; source .env; set +a
# The application reads these as ordinary environment variables.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_study_gap_analyzer
DB_USERNAME=gap_app
DB_PASSWORD=
AUTH_SESSION_HOURS=24
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Optional: directory of the static frontend, relative to backend/ (default ../frontend).
# FRONTEND_DIR=../frontend
# Optional, tests only: the seed students' development password (enables one extra test).
# SEED_TEST_PASSWORD=
